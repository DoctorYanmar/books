.DS_Store
__pycache__/
*.py[cod]

# The library holds the user's own copies of the books. Nothing in it is committed.
/library/*
!/library/.gitkeep

# Extracted book text is the book itself, in plain form — local only, never pushed.
*/source/

# Book files anywhere in the tree, whatever they are called.
*.epub
*.pdf
*.fb2
*.mobi
*.azw3
*.djvu
