.DS_Store
__pycache__/
*.py[cod]

# The library is local. Every book lives in library/<slug>/ — the file itself, the extracted
# text, the whole pack, the page. None of it is committed: the packs quote copyrighted books
# at length and the source/ directories are the books in plain form.
/library/*
!/library/.gitkeep

# Book files anywhere in the tree, in case one is dropped outside the library by mistake.
*.epub
*.pdf
*.fb2
*.mobi
*.azw3
*.djvu
